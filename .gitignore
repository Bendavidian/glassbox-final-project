# Secrets — never tracked
.env
.env.*
!.env.example

# Data and model artefacts
# The parquet snapshots stay out of git; the quality report does not. It is a provenance
# artifact — it records what the data looked like when a result was produced, which a
# reader of that result needs and cannot reconstruct. Note the pattern: `data_cache/`
# would exclude the directory itself and make the negation below unreachable.
data_cache/*
!data_cache/quality_report.json
checkpoints/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
