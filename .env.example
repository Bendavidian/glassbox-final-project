# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Alpaca paper trading credentials — https://app.alpaca.markets (Paper Trading tab).
# These are paper-account keys. This project never uses live keys: scripts and the live
# loop call require_paper_endpoint() and refuse to run against any other endpoint.

ALPACA_API_KEY=your-paper-api-key-here
ALPACA_SECRET_KEY=your-paper-secret-key-here

# Optional. Defaults to the paper endpoint when unset. Any other value is refused.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
